<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ kol.payout: search ============ -->
    <record id="view_kol_payout_search" model="ir.ui.view">
        <field name="name">kol.payout.search</field>
        <field name="model">kol.payout</field>
        <field name="arch" type="xml">
            <search string="Đối soát payout">
                <field name="name"/>
                <field name="platform"/>
                <field name="statement_ref"/>
                <filter name="f_shopee" string="Shopee" domain="[('platform','=','shopee')]"/>
                <filter name="f_tiktok" string="TikTok Shop" domain="[('platform','=','tiktok')]"/>
                <filter name="f_lazada" string="Lazada" domain="[('platform','=','lazada')]"/>
                <separator/>
                <filter name="f_matched" string="Khớp" domain="[('match_state','=','ok')]"/>
                <filter name="f_mismatch" string="Lệch" domain="[('match_state','=','diff')]"/>
                <separator/>
                <filter name="f_draft" string="Chờ nhận tiền" domain="[('state','=','draft')]"/>
                <filter name="f_paid" string="Đã nhận tiền" domain="[('state','=','paid')]"/>
                <filter name="filter_period" string="Kỳ" date="period_start"/>
                <group name="group_by">
                    <filter name="gb_platform" string="Nền tảng" context="{'group_by':'platform'}"/>
                    <filter name="gb_match" string="Đối soát" context="{'group_by':'match_state'}"/>
                    <filter name="gb_state" string="Trạng thái" context="{'group_by':'state'}"/>
                    <filter name="gb_month" string="Tháng" context="{'group_by':'period_start:month'}"/>
                </group>
                <searchpanel>
                    <field name="platform" icon="fa-shopping-bag" enable_counters="1"/>
                    <field name="match_state" select="multi" icon="fa-balance-scale" enable_counters="1"/>
                    <field name="state" select="multi" icon="fa-flag" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ============ kol.payout: list ============ -->
    <record id="view_kol_payout_list" model="ir.ui.view">
        <field name="name">kol.payout.list</field>
        <field name="model">kol.payout</field>
        <field name="arch" type="xml">
            <list string="Đối soát payout" decoration-success="match_state == 'ok'" decoration-danger="match_state == 'diff'">
                <field name="name"/>
                <field name="platform"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="order_count" sum="Đơn"/>
                <field name="gross_amount" sum="Doanh thu"/>
                <field name="total_fees" sum="Phí"/>
                <field name="payout_expected" sum="Đáng nhận"/>
                <field name="payout_declared" sum="Sàn báo"/>
                <field name="diff" sum="Lệch"/>
                <field name="match_state" widget="badge" decoration-success="match_state == 'ok'" decoration-danger="match_state == 'diff'"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============ kol.payout: form ============ -->
    <record id="view_kol_payout_form" model="ir.ui.view">
        <field name="name">kol.payout.form</field>
        <field name="model">kol.payout</field>
        <field name="arch" type="xml">
            <form string="Đối soát payout">
                <header>
                    <button name="action_reconcile" type="object" string="Đối soát" class="btn-primary"/>
                    <button name="action_mark_paid" type="object" string="Xác nhận đã nhận tiền" invisible="state == 'paid'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Đơn trong kỳ"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Khớp" bg_color="text-bg-success" invisible="match_state != 'ok'"/>
                    <widget name="web_ribbon" title="Lệch" bg_color="text-bg-danger" invisible="match_state != 'diff'"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="vd: Shopee · Kỳ 01–15/07/2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="platform"/>
                            <field name="shop_id"/>
                            <field name="statement_ref"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                    </group>
                    <group>
                        <group string="Phí sàn đã trừ">
                            <field name="fee_commission"/>
                            <field name="fee_payment"/>
                            <field name="fee_shipping"/>
                            <field name="fee_voucher"/>
                            <field name="total_fees"/>
                        </group>
                        <group string="Khớp payout">
                            <field name="gross_amount"/>
                            <field name="payout_expected"/>
                            <field name="payout_declared"/>
                            <field name="diff"/>
                            <field name="match_state" widget="badge" decoration-success="match_state == 'ok'" decoration-danger="match_state == 'diff'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết theo đơn">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="order_id"/>
                                    <field name="gross" sum="Doanh thu"/>
                                    <field name="fee_commission" sum="Hoa hồng"/>
                                    <field name="fee_payment" sum="Thanh toán"/>
                                    <field name="fee_shipping" sum="Vận chuyển"/>
                                    <field name="fee_voucher" sum="Voucher"/>
                                    <field name="net_payout" sum="Thực nhận"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ kol.payout: pivot (phân tích phí) ============ -->
    <record id="view_kol_payout_pivot" model="ir.ui.view">
        <field name="name">kol.payout.pivot</field>
        <field name="model">kol.payout</field>
        <field name="arch" type="xml">
            <pivot string="Phí &amp; payout theo sàn" sample="1">
                <field name="platform" type="row"/>
                <field name="fee_commission" type="measure"/>
                <field name="fee_payment" type="measure"/>
                <field name="fee_shipping" type="measure"/>
                <field name="fee_voucher" type="measure"/>
                <field name="payout_expected" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_kol_payout" model="ir.actions.act_window">
        <field name="name">Đối soát payout</field>
        <field name="res_model">kol.payout</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_kol_payout_search"/>
    </record>

    <menuitem id="menu_kol_finance" name="Tài chính" parent="menu_kol_root" sequence="27"
              groups="bsd_kol_report.group_kol_viewer"/>
    <menuitem id="menu_kol_payout" name="Đối soát payout" parent="menu_kol_finance"
              action="action_kol_payout" sequence="10"/>

</odoo>
